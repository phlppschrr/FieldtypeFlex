[
	{"name":"empty format", "format":"", "type":"Item", "text":"", "titleText":"Item Item #1", "titleBadges":["Item"]},
	{"name":"literal", "format":"Info", "text":"Info"},
	{"name":"property", "format":"{heading}", "values":{"heading":"Fish & Chips"}, "text":"Fish & Chips", "titleText":"Fish & Chips"},
	{"name":"missing property", "format":"{missing}", "text":"", "titleText":"#1"},
	{"name":"blank display value", "format":"{heading}", "values":{"heading":""}, "text":"", "titleText":"#1"},
	{"name":"whitespace fallback", "format":"{heading|other}", "values":{"heading":" \t\n", "other":"Fallback"}, "text":"Fallback"},
	{"name":"zero fallback", "format":"{heading|price|other}", "values":{"heading":"", "price":"0", "other":"Other"}, "text":"0"},
	{"name":"no recursive tokens", "format":"{heading}", "values":{"heading":"[Literal] <b>Safe</b> #n {other}"}, "text":"[Literal] <b>Safe</b> #n {other}"},
	{"name":"unicode", "format":"{heading} – {other}", "values":{"heading":"Grüße 👋", "other":"東京"}, "text":"Grüße 👋 – 東京"},
	{"name":"number", "format":"#N: {heading}", "number":12, "values":{"heading":"Title"}, "text":"#12: Title"},
	{"name":"type and path", "format":"{@path} › {@type} #n", "type":"Text", "path":"Section › Group", "text":"Section › Group › Text #1"},
	{"name":"root path", "format":"{@path} › {@type}", "type":"Text", "text":"Text"},
	{"name":"type fallback", "format":"{missing|@type}", "type":"Text", "text":"Text"},
	{"name":"badge", "format":"_{@type}_ {heading}", "type":"Text", "values":{"heading":"Title"}, "text":"Text Title", "badges":["Text"]},
	{"name":"empty badge", "format":"_{missing}_", "text":"", "titleText":"#1"},
	{"name":"badge fallback", "format":"_{missing|price}_", "values":{"price":"0"}, "text":"0", "badges":["0"]},
	{"name":"muted literal", "format":"[Info] {heading}", "values":{"heading":"Title"}, "text":"Info Title", "muted":["Info"]},
	{"name":"muted tokens", "format":"[{@type} #n:] {heading}", "type":"Text", "values":{"heading":"Title"}, "text":"Text #1: Title", "muted":["Text", " ", "#1", ":"]},
	{"name":"muted badge", "format":"[_{price}_] {heading}", "values":{"price":"0", "heading":"Title"}, "text":"0 Title", "badges":["0"], "muted":["0"]},
	{"name":"empty group", "format":"[{missing}] / {heading}", "values":{"heading":"Title"}, "text":"Title"},
	{"name":"literal empty group", "format":"{heading} / [] / {price}", "values":{"heading":"Title", "price":"0"}, "text":"Title / 0"},
	{"name":"unmatched bracket", "format":"[Unclosed {heading}", "values":{"heading":"Title"}, "text":"[Unclosed Title"},
	{"name":"unmatched brace", "format":"Literal {heading", "text":"Literal {heading"},
	{"name":"leading separators", "format":"{@path} / _{missing}_ / #n: _{absent}_", "text":"#1"},
	{"name":"omitted middle", "format":"{heading} / _{missing}_ / {price}", "values":{"heading":"Title", "price":"0"}, "text":"Title / 0"},
	{"name":"omitted tail", "format":"{heading} — {missing}", "values":{"heading":"Title"}, "text":"Title"},
	{"name":"all separators", "format":" / {missing} — ", "text":""},
	{"name":"literal punctuation", "format":"({heading})", "values":{"heading":"Title"}, "text":"(Title)"},
	{"name":"punctuation value", "format":"{heading} / {other}", "values":{"heading":"/", "other":"Title"}, "text":"/ / Title"},
	{"name":"cleanup at group edge", "format":"[› {@type}:] {heading}", "type":"Text", "values":{"heading":"Title"}, "text":"Text: Title", "muted":["Text", ":"]}
]
